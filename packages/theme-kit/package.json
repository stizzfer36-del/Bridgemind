{
  "name": "@forge/theme-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "description": "JSON schema + validator for Forge themes.",
  "bin": {
    "forge-validate-themes": "src/validate.ts"
  },
