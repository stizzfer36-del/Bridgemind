{
  "name": "@forge/sdk-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript SDK generated from spec/openapi.yaml.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-generator-cli generate -i ../../spec/openapi.yaml -g typescript-fetch -o generated",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.0",
    "typescript": "^5.4.0"
  }
}
