generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String?
  userId    String
  createdAt DateTime @default(now())
  revokedAt DateTime?
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
  agents      Agent[]
  swarms      Swarm[]

  @@index([userId])
}

model Task {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status          String   @default("todo")
  instructions    String
  taskKnowledge   String?
  role            String?
  runId           String?
  assignedAgentId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
}

model Agent {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  systemPrompt String
  model        String   @default("claude-opus-4-7")
  cliBinary    String   @default("claude")
  cliArgs      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
}

model Swarm {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal      String
  status    String    @default("running")
  roles     String    // JSON-encoded Role[]
  mailboxId String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([projectId])
}

model Message {
  id          String   @id @default(uuid())
  swarmId     String
  swarm       Swarm    @relation(fields: [swarmId], references: [id], onDelete: Cascade)
  fromAgentId String
  toAgentId   String?
  body        String
  sig         String
  ts          BigInt

  @@index([swarmId])
}

model RunTrace {
  id        String   @id @default(uuid())
  taskId    String
  events    String   // JSONL serialized
  createdAt DateTime @default(now())

  @@index([taskId])
}

model BenchResult {
  id         String   @id @default(uuid())
  category   String
  model      String
  taskId     String
  score      Float
  durationMs Int
  output     String?
  createdAt  DateTime @default(now())
  @@index([category, model])
}
